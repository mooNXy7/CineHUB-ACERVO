{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinehub.example/schemas/radios/v1.schema.json",
  "title": "CineHUB radios candidate v1",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "records",
    "quarantine"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domain": {
      "const": "radios"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "streams",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genre": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "streams": {
            "type": "array",
            "items": {
              "$ref": "../common/stream-variant-v1.schema.json"
            }
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "../common/provenance-v1.schema.json"
            }
          },
          "raw": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "quarantine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
