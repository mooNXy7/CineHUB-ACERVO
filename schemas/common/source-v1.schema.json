{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinehub.example/schemas/common/source-v1.schema.json",
  "title": "CineHUB source v1",
  "type": "object",
  "required": [
    "id",
    "domain",
    "format",
    "priority",
    "enabled",
    "provider"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "enum": [
        "vod",
        "channels",
        "radios",
        "logos",
        "epg"
      ]
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "url_template": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "match_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "provenance-v1.schema.json"
      }
    },
    "raw": {
      "type": "object"
    },
    "origin": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "url",
            "repository_path"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "quarantined",
        "degraded",
        "pending_review"
      ]
    },
    "update_frequency": {
      "type": "string"
    },
    "last_processed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "credentials_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "adapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "provider": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
