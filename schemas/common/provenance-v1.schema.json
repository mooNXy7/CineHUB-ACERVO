{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinehub.example/schemas/common/provenance-v1.schema.json",
  "title": "CineHUB provenance v1",
  "type": "object",
  "required": [
    "source_id",
    "method",
    "parser_version",
    "collected_at",
    "input_sha256"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "collected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_fields": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
