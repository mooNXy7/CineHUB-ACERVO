{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinehub.example/schemas/epg-channels/v1.schema.json",
  "title": "CineHUB epg-channels candidate v1",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "records",
    "quarantine"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domain": {
      "const": "epg-channels"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_names",
          "source_id",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_id": {
            "type": "string"
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "../common/provenance-v1.schema.json"
            }
          },
          "raw": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "quarantine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
